# Private key for deploying contracts (without 0x prefix works too)
PRIVATE_KEY=0x...

# Sepolia RPC URL (Infura, Alchemy, or public)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_API_KEY

# Mainnet RPC URL
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_API_KEY

# NIL token address
# Sepolia: set after running `just deploy-token-sepolia`
# Mainnet: 0x... (the real NIL token address)
NIL_TOKEN_ADDRESS=

# Optional: Etherscan API key for contract verification
ETHERSCAN_API_KEY=
